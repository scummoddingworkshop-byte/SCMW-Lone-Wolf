<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Serilog" Version="4.4.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- The field library's reference data ships inside the assembly, so it needs no file paths. -->
    <None Remove="Knowledge\library\**\*.json" />
    <EmbeddedResource Include="Knowledge\library\**\*.json" />

    <!-- The crafting menu's shelves and order, read from the game by tools/GameModel. -->
    <None Remove="Content\recipe-groups.json" />
    <EmbeddedResource Include="Content\recipe-groups.json" />
  </ItemGroup>

</Project>
