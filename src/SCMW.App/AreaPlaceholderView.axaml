<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="SCMW.App.AreaPlaceholderView">
  <Border Background="{StaticResource BgCardBrush}" CornerRadius="10"
          BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="24">
    <StackPanel Spacing="8">
      <TextBlock Name="TitleText" FontSize="22" FontWeight="SemiBold"
                 Foreground="{StaticResource TextPrimaryBrush}"/>
      <TextBlock Text="This area is coming in a later step."
                 Foreground="{StaticResource TextDimBrush}"/>
    </StackPanel>
  </Border>
</UserControl>
