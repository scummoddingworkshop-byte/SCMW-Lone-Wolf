<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="SCMW.App.Controls.IconButton">
  <Button Name="Inner" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
      <!-- Icon slot: the placeholder box stays put; the image appears when one is set. -->
      <Border Width="16" Height="16" CornerRadius="3"
              Background="{StaticResource BorderBrush}">
        <Image Name="IconImage" Width="16" Height="16" Stretch="Uniform" IsVisible="False"/>
      </Border>
      <TextBlock Name="LabelText" VerticalAlignment="Center" FontSize="14"/>
    </StackPanel>
  </Button>
</UserControl>
