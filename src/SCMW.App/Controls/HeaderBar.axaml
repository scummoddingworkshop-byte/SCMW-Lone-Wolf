<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:SCMW.App"
             x:Class="SCMW.App.Controls.HeaderBar"
             x:DataType="vm:ShellViewModel">
  <!-- Top bar: the open project. The brand and version live in the window title bar. -->
  <Border Classes="panel" Height="64" Padding="16,0" BorderThickness="0,0,0,1">
    <Grid ColumnDefinitions="Auto,*">
      <!-- The open project: a leading label, its picture, then name and description. -->
      <Grid Grid.Column="0" ColumnDefinitions="Auto,Auto,*" ColumnSpacing="12" VerticalAlignment="Center"
            IsVisible="{Binding HasCurrentProject}">
        <TextBlock Grid.Column="0" Text="Selected&#10;Project" TextAlignment="Right"
                   Classes="dim" VerticalAlignment="Center"/>
        <Border Grid.Column="1" Classes="thumb" Width="40" Height="40" VerticalAlignment="Center">
          <Panel>
            <TextBlock Text="SCMW" FontSize="9" Foreground="{StaticResource TextDimBrush}"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <Image Source="{Binding CurrentProject.Picture}" Stretch="UniformToFill"/>
          </Panel>
        </Border>
        <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="1" MaxWidth="420">
          <TextBlock Text="{Binding CurrentProject.Name}" FontSize="16" FontWeight="SemiBold"
                     Foreground="{StaticResource TextPrimaryBrush}"
                     TextTrimming="CharacterEllipsis"/>
          <TextBlock Text="{Binding CurrentProject.Description}" Classes="dim"
                     TextTrimming="CharacterEllipsis"/>
        </StackPanel>
      </Grid>

      <!-- No project open. -->
      <TextBlock Grid.Column="0" Text="No project open" FontSize="16" Classes="dim"
                 VerticalAlignment="Center" IsVisible="{Binding !HasCurrentProject}"/>
    </Grid>
  </Border>
</UserControl>
