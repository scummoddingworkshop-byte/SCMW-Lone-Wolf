<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="SCMW.App.Controls.ItemRow">
  <StackPanel Orientation="Horizontal" Spacing="10">
    <Border Classes="thumb" Width="32" Height="32" VerticalAlignment="Center">
      <Panel>
        <TextBlock Name="DefaultMark" Text="SCMW" FontSize="8"
                   Foreground="{StaticResource TextDimBrush}"
                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
        <Image Name="Picture" Stretch="UniformToFill" IsVisible="False"/>
      </Panel>
    </Border>
    <StackPanel VerticalAlignment="Center">
      <TextBlock Name="NameText" FontSize="13"/>
      <TextBlock Name="CategoryText" Classes="dim"/>
    </StackPanel>
  </StackPanel>
</UserControl>
