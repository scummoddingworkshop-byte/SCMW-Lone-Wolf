<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:SCMW.App"
             x:Class="SCMW.App.Views.BackupsView"
             x:DataType="vm:BackupsViewModel">
  <UserControl.Resources>
    <!-- One kept copy, used by both the Projects and the Mods area, so they stay identical. -->
    <DataTemplate x:Key="BackupRowTemplate" x:DataType="vm:BackupRow">
      <Border Classes="listrow" Margin="0,0,0,8">
        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
          <Border Grid.Column="0" Classes="chip" VerticalAlignment="Center">
            <TextBlock Text="{Binding KindText}" Classes="dim"/>
          </Border>

          <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
            <TextBlock Text="{Binding DisplayName}" Foreground="{StaticResource TextPrimaryBrush}"/>
            <TextBlock Text="{Binding When}" Classes="dim"/>
          </StackPanel>

          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <Button Classes="primary" Content="Restore"
                    Command="{Binding $parent[UserControl].((vm:BackupsViewModel)DataContext).RestoreCommand}"
                    CommandParameter="{Binding}"/>
            <Button Classes="secondary" Content="Delete"
                    IsVisible="{Binding !IsConfirmingDelete}"
                    Command="{Binding $parent[UserControl].((vm:BackupsViewModel)DataContext).RequestDeleteCommand}"
                    CommandParameter="{Binding}"/>
            <Button Classes="secondary" Content="Cancel"
                    IsVisible="{Binding IsConfirmingDelete}"
                    Command="{Binding $parent[UserControl].((vm:BackupsViewModel)DataContext).CancelDeleteCommand}"
                    CommandParameter="{Binding}"/>
            <Button Classes="primary" Content="Delete for good"
                    IsVisible="{Binding IsConfirmingDelete}"
                    Command="{Binding $parent[UserControl].((vm:BackupsViewModel)DataContext).ConfirmDeleteCommand}"
                    CommandParameter="{Binding}"/>
          </StackPanel>
        </Grid>
      </Border>
    </DataTemplate>
  </UserControl.Resources>

  <ScrollViewer>
    <StackPanel Spacing="20" Margin="24,8,24,24">

      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
        <StackPanel Grid.Column="0" Spacing="4">
          <TextBlock Text="Backups" Classes="h1"/>
          <TextBlock Name="SummaryText" Text="{Binding Summary}" Classes="dim"/>
        </StackPanel>
        <Button Grid.Column="1" Classes="secondary" Content="Open backups folder"
                VerticalAlignment="Center" Command="{Binding OpenFolderCommand}"/>
      </Grid>

      <TextBlock Text="When you remove a mod or delete a project, SCMW — Lone Wolf keeps a copy here — nothing is lost. Restore puts it back."
                 Classes="dim" TextWrapping="Wrap"/>

      <TextBlock Name="MessageText" Text="{Binding Message}" Classes="dim" TextWrapping="Wrap"
                 IsVisible="{Binding Message, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

      <!-- The player's saved game (SCUM.db): the one soft spot a pak cannot undo. -->
      <Border Name="SaveCard" Classes="card" IsVisible="{Binding HasSaveService}">
        <StackPanel Spacing="10">
          <TextBlock Text="Your saved game" Classes="section"/>
          <TextBlock Name="SaveNote" Text="{Binding SaveNote}" Classes="dim" TextWrapping="Wrap"/>

          <Button Name="BackUpSaveButton" Classes="primary" HorizontalAlignment="Left"
                  Content="Back up save now"
                  IsEnabled="{Binding CanBackUpSave}"
                  Command="{Binding BackUpSaveCommand}"/>

          <ItemsControl Name="SaveList" ItemsSource="{Binding Saves}" IsVisible="{Binding HasSaves}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:SaveRow">
                <Border Classes="listrow" Margin="0,0,0,8">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                      <TextBlock Text="{Binding When}" Foreground="{StaticResource TextPrimaryBrush}"/>
                      <TextBlock Text="{Binding Size}" Classes="dim"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                      <Button Classes="primary" Content="Restore"
                              Command="{Binding $parent[UserControl].((vm:BackupsViewModel)DataContext).RestoreSaveCommand}"
                              CommandParameter="{Binding}"/>
                      <Button Classes="secondary" Content="Delete"
                              IsVisible="{Binding !IsConfirmingDelete}"
                              Command="{Binding $parent[UserControl].((vm:BackupsViewModel)DataContext).RequestDeleteSaveCommand}"
                              CommandParameter="{Binding}"/>
                      <Button Classes="secondary" Content="Cancel"
                              IsVisible="{Binding IsConfirmingDelete}"
                              Command="{Binding $parent[UserControl].((vm:BackupsViewModel)DataContext).CancelDeleteSaveCommand}"
                              CommandParameter="{Binding}"/>
                      <Button Classes="primary" Content="Delete for good"
                              IsVisible="{Binding IsConfirmingDelete}"
                              Command="{Binding $parent[UserControl].((vm:BackupsViewModel)DataContext).ConfirmDeleteSaveCommand}"
                              CommandParameter="{Binding}"/>
                    </StackPanel>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <TextBlock Text="No save copies kept yet." Classes="dim" IsVisible="{Binding ShowNoSaves}"/>
        </StackPanel>
      </Border>

      <!-- Deleted projects: a copy kept, so a project is never really lost. -->
      <Border Name="ProjectCard" Classes="card">
        <StackPanel Spacing="10">
          <TextBlock Text="Projects" Classes="section"/>
          <TextBlock Name="ProjectNote" Text="{Binding ProjectNote}" Classes="dim" TextWrapping="Wrap"/>

          <ItemsControl Name="ProjectList" ItemsSource="{Binding ProjectBackups}"
                        ItemTemplate="{StaticResource BackupRowTemplate}"
                        IsVisible="{Binding HasProjectBackups}"/>

          <TextBlock Text="No project copies kept yet." Classes="dim"
                     IsVisible="{Binding ShowNoProjectBackups}"/>
        </StackPanel>
      </Border>

      <!-- Mods we replaced in SCUM: a copy kept, so the older build can come back. -->
      <Border Name="ModCard" Classes="card">
        <StackPanel Spacing="10">
          <TextBlock Text="Mods" Classes="section"/>
          <TextBlock Name="ModNote" Text="{Binding ModNote}" Classes="dim" TextWrapping="Wrap"/>

          <ItemsControl Name="ModList" ItemsSource="{Binding ModBackups}"
                        ItemTemplate="{StaticResource BackupRowTemplate}"
                        IsVisible="{Binding HasModBackups}"/>

          <TextBlock Text="No mod copies kept yet." Classes="dim" IsVisible="{Binding ShowNoModBackups}"/>
        </StackPanel>
      </Border>

    </StackPanel>
  </ScrollViewer>
</UserControl>
