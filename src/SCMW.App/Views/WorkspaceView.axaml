<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:SCMW.App"
             xmlns:content="clr-namespace:SCMW.Core.Content;assembly=SCMW.Core"
             xmlns:controls="clr-namespace:SCMW.App.Controls"
             x:Class="SCMW.App.Views.WorkspaceView"
             x:DataType="vm:WorkspaceViewModel">
  <UserControl.Resources>
    <!-- The "start from" dropdown, built fresh for each open of the New-recipe panel (see its host). -->
    <DataTemplate x:Key="DonorPickerTemplate" x:DataType="vm:WorkspaceViewModel">
      <controls:SearchPicker Name="NewRecipeDonorPicker" Width="300"
                             ItemsSource="{Binding RecipeDonors}"
                             SelectedItem="{Binding NewRecipeDonor, Mode=TwoWay}">
        <controls:SearchPicker.ItemTemplate>
          <DataTemplate x:DataType="vm:DonorChoice">
            <TextBlock Text="{Binding Label}"/>
          </DataTemplate>
        </controls:SearchPicker.ItemTemplate>
      </controls:SearchPicker>
    </DataTemplate>
    <!-- The "Makes" dropdown, also built fresh for each open (same dropdown quirk). -->
    <DataTemplate x:Key="ProductPickerTemplate" x:DataType="vm:WorkspaceViewModel">
      <controls:SearchPicker Name="NewRecipeProductPicker" Width="300"
                             ItemsSource="{Binding ProductChoices}"
                             SelectedItem="{Binding NewRecipeProduct, Mode=TwoWay}">
        <controls:SearchPicker.ItemTemplate>
          <DataTemplate x:DataType="vm:ProductChoice">
            <TextBlock Text="{Binding Label}"/>
          </DataTemplate>
        </controls:SearchPicker.ItemTemplate>
      </controls:SearchPicker>
    </DataTemplate>
    <!-- The open recipe's "Makes" dropdown, built fresh per recipe open (same dropdown quirk). -->
    <DataTemplate x:Key="OpenProductPickerTemplate" x:DataType="vm:WorkspaceViewModel">
      <controls:SearchPicker Name="OpenMakesPicker" Width="300"
                             ItemsSource="{Binding OpenProductChoices}"
                             SelectedItem="{Binding OpenRecipeProduct, Mode=TwoWay}">
        <controls:SearchPicker.ItemTemplate>
          <DataTemplate x:DataType="vm:ProductChoice">
            <TextBlock Text="{Binding Label}"/>
          </DataTemplate>
        </controls:SearchPicker.ItemTemplate>
      </controls:SearchPicker>
    </DataTemplate>
    <!-- The open item's category dropdowns, also built fresh per item open (same quirk). -->
    <DataTemplate x:Key="ItemCategoryPickerTemplate" x:DataType="vm:WorkspaceViewModel">
      <controls:SearchPicker Name="ItemCategoryPicker" Width="260"
                             ItemsSource="{Binding CategoryChoices}"
                             SelectedItem="{Binding NewItemCategory, Mode=TwoWay}">
        <controls:SearchPicker.ItemTemplate>
          <DataTemplate x:DataType="content:CategoryChoice">
            <TextBlock Text="{Binding Label}"/>
          </DataTemplate>
        </controls:SearchPicker.ItemTemplate>
      </controls:SearchPicker>
    </DataTemplate>
    <DataTemplate x:Key="CategoryDonorPickerTemplate" x:DataType="vm:WorkspaceViewModel">
      <controls:SearchPicker Name="CategoryDonorPicker" Width="260"
                             ItemsSource="{Binding CategoryDonors}"
                             SelectedItem="{Binding NewCategoryDonor, Mode=TwoWay}">
        <controls:SearchPicker.ItemTemplate>
          <DataTemplate x:DataType="content:CategoryChoice">
            <TextBlock Text="{Binding Label}"/>
          </DataTemplate>
        </controls:SearchPicker.ItemTemplate>
      </controls:SearchPicker>
    </DataTemplate>
  </UserControl.Resources>
  <!-- The adapting Workspace: find a file by name and the game's own category, tick "only
       changeable" to hide the rest, then its real fields show, explained, on the right. -->
  <Grid ColumnDefinitions="2*,12,3*" RowDefinitions="Auto,*" Margin="28,8,28,24">

    <!-- "One project = one mod": with nothing chosen, editing is refused and explained here. -->
    <Border Grid.Row="0" Grid.ColumnSpan="3" Name="NeedsProjectWarning" Classes="card"
            IsVisible="{Binding NeedsProject}" Margin="0,0,0,12">
      <TextBlock Text="{Binding ProjectWarning}" TextWrapping="Wrap"
                 Foreground="{StaticResource WarningBrush}"/>
    </Border>

    <!-- Left: find + browse -->
    <Grid Grid.Row="1" Grid.Column="0" RowDefinitions="Auto,Auto,Auto,Auto,*">
      <ListBox Grid.Row="0" Name="KindChips" Classes="chips"
               ItemsSource="{Binding Kinds}"
               SelectedItem="{Binding SelectedKind, Mode=TwoWay}">
        <ListBox.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel/>
          </ItemsPanelTemplate>
        </ListBox.ItemsPanel>
        <ListBox.ItemTemplate>
          <DataTemplate>
            <TextBlock Text="{Binding}"/>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <TextBox Grid.Row="1" Name="SearchBox" Classes="field" Margin="0,12,0,0" Watermark="Search by name…"
               Text="{Binding Search, Mode=TwoWay}"/>

      <ListBox Grid.Row="2" Name="CategoryChips" Classes="chips" Margin="0,12,0,0"
               ItemsSource="{Binding Categories}"
               SelectedItem="{Binding SelectedCategory, Mode=TwoWay}">
        <ListBox.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel/>
          </ItemsPanelTemplate>
        </ListBox.ItemsPanel>
        <ListBox.ItemTemplate>
          <DataTemplate>
            <TextBlock Text="{Binding}"/>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <!-- The list's "New" button: makes a new item from the Items list, a new recipe from Recipes. -->
      <Button Grid.Row="3" Name="NewRecipeButton" Classes="secondary" Content="{Binding NewButtonText}"
              HorizontalAlignment="Left" Margin="0,12,0,0"
              IsVisible="{Binding ShowNewRecipeButton}"
              ToolTip.Tip="Make a brand-new recipe or item"
              Command="{Binding OpenNewRecipeCommand}"/>

      <ListBox Grid.Row="4" Name="AssetList" Classes="items" Margin="0,8,0,0" Padding="0,0,12,0"
               ItemsSource="{Binding VisibleAssets}"
               SelectedItem="{Binding SelectedAsset, Mode=TwoWay}"
               IsVisible="{Binding HasAssetMatches}">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:ItemSummary">
            <controls:ItemRow Item="{Binding}"/>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <Border Grid.Row="4" Name="NoAssetMatches" Classes="card" VerticalAlignment="Top"
              IsVisible="{Binding ShowAssetNoMatches}">
        <TextBlock Text="Nothing matches that" Classes="dim"/>
      </Border>
    </Grid>

    <!-- Right: the open file's real fields, explained -->
    <Grid Grid.Row="1" Grid.Column="2" RowDefinitions="Auto,Auto,*">
      <TextBlock Grid.Row="0" Name="TitleText" Classes="h1" Text="{Binding Title}"
                 IsVisible="{Binding ShowTitle}"/>

      <TextBlock Grid.Row="1" Classes="dim" Margin="0,8,0,0"
                 Text="This file has no values to show."
                 IsVisible="{Binding ShowNoFields}"/>

      <ScrollViewer Grid.Row="2" Margin="0,12,0,0" Padding="0,0,12,0">
        <StackPanel>
          <!-- Make a brand-new recipe (Task 7.5): a plain name and a recipe to start from. -->
          <Border Name="NewRecipeCard" Classes="card" Margin="0,0,0,14"
                  IsVisible="{Binding ShowNewRecipe}">
            <StackPanel Spacing="10">
              <TextBlock Classes="section" Text="{Binding NewPanelTitle}"/>
              <TextBlock Classes="dim" TextWrapping="Wrap"
                         Text="Give it a name and pick one to copy. Your project keeps the new one; the game's own file is left untouched."/>
              <StackPanel Spacing="4">
                <TextBlock Text="Name" Classes="dim"/>
                <TextBox Name="NewRecipeNameBox" Classes="field" MinWidth="200"
                         Watermark="e.g. Olive Press"
                         Text="{Binding NewRecipeName, Mode=TwoWay}"/>
              </StackPanel>
              <StackPanel Spacing="4">
                <TextBlock Text="Start from" Classes="dim"/>
                <!-- Filled in code each time the panel opens: a fresh dropdown is built per open,
                     because the app's dropdown stops opening once its card has been hidden and shown. -->
                <ContentControl Name="NewRecipeDonorHost"/>
              </StackPanel>
              <!-- What the new recipe makes (Phase 8.2): point it at any item — the game's own or one
                   of your new ones. Left alone, it keeps whatever the recipe you started from makes. -->
              <StackPanel Spacing="4" IsVisible="{Binding ShowProductPicker}">
                <TextBlock Text="Makes" Classes="dim"/>
                <ContentControl Name="NewRecipeProductHost"/>
                <TextBlock Classes="dim" TextWrapping="Wrap"
                           Text="Optional — pick what the recipe produces. Leave it to keep the recipe you started from."/>
              </StackPanel>
              <TextBlock Text="{Binding NewRecipeNotice}" TextWrapping="Wrap" Classes="dim"
                         Foreground="{StaticResource WarningBrush}"
                         IsVisible="{Binding HasNewRecipeNotice}"/>
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Name="CreateNewRecipe" Classes="primary" Content="Create"
                        Command="{Binding CreateNewRecipeCommand}"/>
                <Button Name="CancelNewRecipe" Classes="secondary" Content="Cancel"
                        Command="{Binding CancelNewRecipeCommand}"/>
              </StackPanel>
            </StackPanel>
          </Border>

          <StackPanel IsVisible="{Binding !ShowNewRecipe}">
          <!-- This file is a brand-new recipe the project made: it can be deleted here. Removing it
               drops its edits too, so no orphan record is left for the build to trip over. -->
          <Border Name="NewRecipeBar" Classes="card" Margin="0,0,0,14"
                  IsVisible="{Binding IsOpenNewRecipe}">
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"
                          IsVisible="{Binding !ConfirmingRemoveNewRecipe}">
                <Border Classes="chip" VerticalAlignment="Center">
                  <TextBlock Text="new" Classes="dim" Foreground="{StaticResource AccentBrush}"/>
                </Border>
                <TextBlock Text="This recipe is new in your project." Classes="dim" VerticalAlignment="Center"/>
              </StackPanel>
              <Button Grid.Column="1" Name="RemoveNewRecipe" Classes="secondary" Content="Remove"
                      VerticalAlignment="Center"
                      ToolTip.Tip="Delete this new recipe from the project"
                      IsVisible="{Binding !ConfirmingRemoveNewRecipe}"
                      Command="{Binding RequestRemoveNewRecipeCommand}"/>

              <TextBlock Grid.Column="0" Grid.ColumnSpan="2" TextWrapping="Wrap"
                         VerticalAlignment="Center" Margin="0,0,12,0"
                         Text="Remove this new recipe from your project? Its changes are removed with it."
                         IsVisible="{Binding ConfirmingRemoveNewRecipe}"/>
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"
                          IsVisible="{Binding ConfirmingRemoveNewRecipe}">
                <Button Name="ConfirmRemoveNewRecipe" Classes="secondary" Content="Remove"
                        Command="{Binding ConfirmRemoveNewRecipeCommand}"/>
                <Button Name="CancelRemoveNewRecipe" Classes="secondary" Content="Cancel"
                        Command="{Binding CancelRemoveNewRecipeCommand}"/>
              </StackPanel>
            </Grid>
          </Border>

          <!-- An item's ingredient categories (Phase 8, Option A): what it counts as when a recipe
               asks for an ingredient, plus a way to make a brand-new category. -->
          <Border Name="ItemCategoryCard" Classes="card" Margin="0,0,0,14"
                  IsVisible="{Binding ShowItemCategories}">
            <StackPanel Spacing="10">
              <TextBlock Classes="section" Text="Ingredient category"/>
              <TextBlock Classes="dim" TextWrapping="Wrap"
                         Text="What this item counts as when a recipe asks for an ingredient. Recipes match categories, not single items."/>

              <TextBlock Text="This item isn't in any category yet." Classes="dim"
                         IsVisible="{Binding HasNoItemCategories}"/>

              <ItemsControl Name="ItemCategoryList" ItemsSource="{Binding ItemCategoryRows}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:ItemCategoryRow">
                    <Border Classes="card" Margin="0,0,0,8" Padding="10">
                      <Grid ColumnDefinitions="*,Auto,Auto">
                        <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                          <TextBlock Text="{Binding Label}"/>
                          <TextBlock Text="{Binding TagName}" Classes="dim"/>
                        </StackPanel>
                        <Border Grid.Column="1" Classes="chip" VerticalAlignment="Center" Margin="0,0,8,0"
                                IsVisible="{Binding HasAmount}">
                          <TextBlock Text="{Binding Amount}" Classes="dim"/>
                        </Border>
                        <Button Grid.Column="2" Name="RemoveItemCategory" Classes="secondary" Content="✕"
                                VerticalAlignment="Center" ToolTip.Tip="Remove this category"
                                Command="{Binding $parent[UserControl].((vm:WorkspaceViewModel)DataContext).RemoveItemCategoryCommand}"
                                CommandParameter="{Binding}"/>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <StackPanel Orientation="Horizontal" Spacing="8">
                <!-- Built in code when the card appears (the app's dropdown quirk). -->
                <ContentControl Name="ItemCategoryPickerHost" VerticalAlignment="Center"/>
                <Button Name="AddItemCategory" Classes="primary" Content="Add"
                        IsEnabled="{Binding CanAddItemCategory}"
                        Command="{Binding AddItemCategoryCommand}"/>
                <Button Name="NewCategoryButton" Classes="secondary" Content="＋ New category"
                        ToolTip.Tip="Make a brand-new ingredient category"
                        Command="{Binding ToggleNewCategoryCommand}"/>
              </StackPanel>

              <StackPanel Spacing="8" IsVisible="{Binding ShowNewCategoryForm}">
                <Border Classes="card" Padding="12">
                  <StackPanel Spacing="8">
                    <TextBlock Text="New category" Classes="section"/>
                    <TextBlock Classes="dim" TextWrapping="Wrap"
                               Text="Give it a name and copy the shape from a game category. It is added to this item and can be used again."/>
                    <StackPanel Spacing="4">
                      <TextBlock Text="Name" Classes="dim"/>
                      <TextBox Name="NewCategoryNameBox" Classes="field" MinWidth="200"
                               Watermark="e.g. Olives"
                               Text="{Binding NewCategoryName, Mode=TwoWay}"/>
                    </StackPanel>
                    <StackPanel Spacing="4">
                      <TextBlock Text="Copy the shape from" Classes="dim"/>
                      <ContentControl Name="CategoryDonorPickerHost" HorizontalAlignment="Left"/>
                    </StackPanel>
                    <TextBlock Text="{Binding NewCategoryNotice}" TextWrapping="Wrap" Classes="dim"
                               Foreground="{StaticResource WarningBrush}"
                               IsVisible="{Binding HasNewCategoryNotice}"/>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <Button Name="CreateItemCategory" Classes="primary" Content="Create"
                              Command="{Binding CreateItemCategoryCommand}"/>
                      <Button Name="CancelItemCategory" Classes="secondary" Content="Cancel"
                              Command="{Binding ToggleNewCategoryCommand}"/>
                    </StackPanel>
                  </StackPanel>
                </Border>
              </StackPanel>

              <TextBlock Text="{Binding CategoryNotice}" TextWrapping="Wrap" Classes="dim"
                         Foreground="{StaticResource WarningBrush}"
                         IsVisible="{Binding HasCategoryNotice}"/>
            </StackPanel>
          </Border>

          <!-- What an existing NEW recipe makes (Phase 8.2 follow-up): set or change its product at
               any time. The dropdown is built fresh per recipe open, like the New panel's ones. -->
          <Border Name="OpenMakesCard" Classes="card" Margin="0,0,0,14"
                  IsVisible="{Binding ShowOpenMakes}">
            <StackPanel Spacing="8">
              <TextBlock Classes="section" Text="Makes"/>
              <TextBlock Classes="dim" TextWrapping="Wrap"
                         Text="What this recipe produces. Pick any item — including one of your own new ones."/>
              <ContentControl Name="OpenMakesHost" HorizontalAlignment="Left"/>
            </StackPanel>
          </Border>

          <!-- A recipe's ingredients: one row per slot, editable (its accepted tag + the five
               per-skill amounts). Those values are owned here, so they leave the list below. -->
          <Border Name="IngredientsCard" Classes="card" Margin="0,0,0,14"
                  IsVisible="{Binding HasIngredients}">
            <StackPanel>
              <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,10">
                <TextBlock Grid.Column="0" Classes="section" Text="Ingredients" VerticalAlignment="Center"/>
                <Button Grid.Column="1" Name="AddIngredient" Classes="secondary" Content="＋ Add ingredient"
                        ToolTip.Tip="Add another ingredient slot"
                        Command="{Binding AddIngredientSlotCommand}"/>
              </Grid>
              <TextBlock Text="{Binding IngredientNotice}" TextWrapping="Wrap" Classes="dim"
                         Foreground="{StaticResource WarningBrush}" Margin="0,0,0,10"
                         IsVisible="{Binding HasIngredientNotice}"/>
              <ItemsControl Name="IngredientList" ItemsSource="{Binding IngredientSlots}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:IngredientSlotRow">
                    <Border Classes="card" Margin="0,0,0,10" Padding="12">
                      <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                        <StackPanel Grid.Row="0" Grid.Column="0" Spacing="6" Margin="0,0,12,0">
                          <TextBlock Text="{Binding Header}" Foreground="{StaticResource TextDimBrush}"/>
                          <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="Accepts" Classes="dim" VerticalAlignment="Center"/>
                            <controls:SearchPicker Name="TagPicker" Width="260"
                                                   ItemsSource="{Binding TagChoices}"
                                                   SelectedItem="{Binding SelectedTag, Mode=TwoWay}"
                                                   SelectionChanged="OnTagChanged">
                              <controls:SearchPicker.ItemTemplate>
                                <DataTemplate x:DataType="content:RecipeTag">
                                  <TextBlock Text="{Binding Label}"/>
                                </DataTemplate>
                              </controls:SearchPicker.ItemTemplate>
                            </controls:SearchPicker>
                          </StackPanel>
                        </StackPanel>

                        <Button Grid.Row="0" Grid.Column="1" Name="RemoveIngredient" Classes="secondary"
                                Content="✕" VerticalAlignment="Top" ToolTip.Tip="Remove this ingredient"
                                Command="{Binding $parent[UserControl].((vm:WorkspaceViewModel)DataContext).RemoveIngredientSlotCommand}"
                                CommandParameter="{Binding}"/>

                        <!-- The five per-skill amounts: click a value to type a new one. -->
                        <ItemsControl Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,10,0,0"
                                      ItemsSource="{Binding Amounts}">
                          <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                              <WrapPanel/>
                            </ItemsPanelTemplate>
                          </ItemsControl.ItemsPanel>
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:WorkspaceField">
                              <StackPanel Margin="0,0,14,8" Spacing="2">
                                <TextBlock Text="{Binding Label}" Classes="dim"/>
                                <Button Classes="valuefield" MinWidth="72" HorizontalContentAlignment="Left"
                                        IsVisible="{Binding ShowValueButton}"
                                        Command="{Binding $parent[UserControl].((vm:WorkspaceViewModel)DataContext).BeginEditCommand}"
                                        CommandParameter="{Binding}">
                                  <TextBlock Text="{Binding Value}" Classes.changed="{Binding IsChanged}"/>
                                </Button>
                                <TextBox Classes="field" MinWidth="72" MinHeight="28"
                                         IsVisible="{Binding IsEditing}" Text="{Binding Draft, Mode=TwoWay}"
                                         KeyDown="OnAmountKeyDown" LostFocus="OnAmountLostFocus"/>
                              </StackPanel>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>

          <!-- A dish's ingredients: one row per ingredient, each with its title and the foods it may
               take (a food points at an item and carries five values). Those values are owned here,
               so they leave the list below. -->
          <Border Name="CookingCard" Classes="card" Margin="0,0,0,14"
                  IsVisible="{Binding HasCookingIngredients}">
            <StackPanel>
              <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,0,0,10">
                <TextBlock Grid.Column="0" Classes="section" Text="Ingredients" VerticalAlignment="Center"/>
                <Button Grid.Column="1" Name="AddCookingMainIngredient" Classes="secondary" Content="＋ Main"
                        ToolTip.Tip="Add a main ingredient" Margin="0,0,6,0"
                        Command="{Binding AddCookingMainIngredientCommand}"/>
                <Button Grid.Column="2" Name="AddCookingOptionalIngredient" Classes="secondary" Content="＋ Optional"
                        ToolTip.Tip="Add an optional ingredient"
                        Command="{Binding AddCookingOptionalIngredientCommand}"/>
              </Grid>
              <TextBlock Text="{Binding CookingNotice}" TextWrapping="Wrap" Classes="dim"
                         Foreground="{StaticResource WarningBrush}" Margin="0,0,0,10"
                         IsVisible="{Binding HasCookingNotice}"/>
              <ItemsControl Name="CookingIngredientList" ItemsSource="{Binding CookingSlots}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:CookingIngredientRow">
                    <Border Classes="card" Margin="0,0,0,10" Padding="12">
                      <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                        <StackPanel Grid.Row="0" Grid.Column="0" Spacing="6" Margin="0,0,12,0">
                          <TextBlock Text="{Binding Header}" Foreground="{StaticResource TextDimBrush}"/>
                          <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding HasTitle}">
                            <TextBlock Text="Title" Classes="dim" VerticalAlignment="Center"/>
                            <Button Classes="valuefield" MinWidth="120" HorizontalContentAlignment="Left"
                                    IsVisible="{Binding Title.ShowValueButton}"
                                    Command="{Binding $parent[UserControl].((vm:WorkspaceViewModel)DataContext).BeginEditCommand}"
                                    CommandParameter="{Binding Title}">
                              <TextBlock Text="{Binding Title.Value}" Classes.changed="{Binding Title.IsChanged}"/>
                            </Button>
                            <TextBox Classes="field" MinWidth="120" MinHeight="28"
                                     IsVisible="{Binding Title.IsEditing}" Text="{Binding Title.Draft, Mode=TwoWay}"
                                     KeyDown="OnAmountKeyDown" LostFocus="OnAmountLostFocus"/>
                          </StackPanel>
                        </StackPanel>

                        <Button Grid.Row="0" Grid.Column="1" Name="RemoveCookingIngredient" Classes="secondary"
                                Content="✕" VerticalAlignment="Top" ToolTip.Tip="Remove this ingredient"
                                Command="{Binding $parent[UserControl].((vm:WorkspaceViewModel)DataContext).RemoveCookingIngredientCommand}"
                                CommandParameter="{Binding}"/>

                        <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Spacing="8" Margin="0,10,0,0">
                          <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0" Text="Foods" Classes="dim" VerticalAlignment="Center"/>
                            <Button Grid.Column="1" Name="AddCookingFood" Classes="secondary" Content="＋ Add food"
                                    ToolTip.Tip="Add a food this ingredient may take"
                                    Command="{Binding $parent[UserControl].((vm:WorkspaceViewModel)DataContext).AddCookingFoodCommand}"
                                    CommandParameter="{Binding}"/>
                          </Grid>
                          <ItemsControl Name="CookingFoodList" ItemsSource="{Binding Foods}">
                            <ItemsControl.ItemTemplate>
                              <DataTemplate x:DataType="vm:CookingFoodRow">
                                <Border Classes="card" Margin="0,0,0,8" Padding="10">
                                  <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                                    <StackPanel Grid.Row="0" Grid.Column="0" Spacing="6" Margin="0,0,12,0">
                                      <TextBlock Text="{Binding Header}" Foreground="{StaticResource TextDimBrush}"/>
                                      <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock Text="Item" Classes="dim" VerticalAlignment="Center"/>
                                        <controls:SearchPicker Name="FoodPicker" Width="260"
                                                               IsVisible="{Binding HasItem}"
                                                               ItemsSource="{Binding Choices}"
                                                               SelectedItem="{Binding SelectedFood, Mode=TwoWay}"
                                                               SelectionChanged="OnCookingFoodChanged">
                                          <controls:SearchPicker.ItemTemplate>
                                            <DataTemplate x:DataType="content:CookingFood">
                                              <TextBlock Text="{Binding Label}"/>
                                            </DataTemplate>
                                          </controls:SearchPicker.ItemTemplate>
                                        </controls:SearchPicker>
                                        <TextBlock Text="{Binding ResourceLabel}" VerticalAlignment="Center"
                                                   IsVisible="{Binding IsResource}"
                                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                                      </StackPanel>
                                    </StackPanel>
                                    <Button Grid.Row="0" Grid.Column="1" Name="RemoveCookingFood" Classes="secondary"
                                            Content="✕" VerticalAlignment="Top" ToolTip.Tip="Remove this food"
                                            Command="{Binding $parent[UserControl].((vm:WorkspaceViewModel)DataContext).RemoveCookingFoodCommand}"
                                            CommandParameter="{Binding}"/>
                                    <ItemsControl Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,10,0,0"
                                                  ItemsSource="{Binding Values}">
                                      <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                          <WrapPanel/>
                                        </ItemsPanelTemplate>
                                      </ItemsControl.ItemsPanel>
                                      <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:WorkspaceField">
                                          <StackPanel Margin="0,0,14,8" Spacing="2">
                                            <TextBlock Text="{Binding Label}" Classes="dim"/>
                                            <Button Classes="valuefield" MinWidth="72" HorizontalContentAlignment="Left"
                                                    IsVisible="{Binding ShowValueButton}"
                                                    Command="{Binding $parent[UserControl].((vm:WorkspaceViewModel)DataContext).BeginEditCommand}"
                                                    CommandParameter="{Binding}">
                                              <TextBlock Text="{Binding Value}" Classes.changed="{Binding IsChanged}"/>
                                            </Button>
                                            <TextBox Classes="field" MinWidth="72" MinHeight="28"
                                                     IsVisible="{Binding IsEditing}" Text="{Binding Draft, Mode=TwoWay}"
                                                     KeyDown="OnAmountKeyDown" LostFocus="OnAmountLostFocus"/>
                                          </StackPanel>
                                        </DataTemplate>
                                      </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                  </Grid>
                                </Border>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                        </StackPanel>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>

          <ItemsControl Name="FieldList" ItemsSource="{Binding Fields}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:WorkspaceField">
                <controls:FieldRow Margin="0,0,0,14"
                    BeginEditCommand="{Binding $parent[UserControl].((vm:WorkspaceViewModel)DataContext).BeginEditCommand}"
                    CommitEditCommand="{Binding $parent[UserControl].((vm:WorkspaceViewModel)DataContext).CommitEditCommand}"
                    CancelEditCommand="{Binding $parent[UserControl].((vm:WorkspaceViewModel)DataContext).CancelEditCommand}"
                    BeginMultiplyCommand="{Binding $parent[UserControl].((vm:WorkspaceViewModel)DataContext).BeginMultiplyCommand}"
                    CommitMultiplyCommand="{Binding $parent[UserControl].((vm:WorkspaceViewModel)DataContext).CommitMultiplyCommand}"
                    CancelMultiplyCommand="{Binding $parent[UserControl].((vm:WorkspaceViewModel)DataContext).CancelMultiplyCommand}"/>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <!-- Fields this file lacks that we can add by copying a donor item's shape (Task 5.2). -->
          <Border Name="AddableSection" Classes="card" Margin="0,12,0,0"
                  IsVisible="{Binding HasAddableFields}">
            <StackPanel>
              <TextBlock Classes="section" Text="Add a value this item doesn't have" Margin="0,0,0,10"/>
              <ItemsControl Name="AddableList" ItemsSource="{Binding AddableFields}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:AddableField">
                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" Margin="0,0,0,14">
                      <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Spacing="6"
                                  VerticalAlignment="Top" Margin="0,7,0,0">
                        <TextBlock Text="{Binding Label}" Foreground="{StaticResource TextDimBrush}"/>
                        <TextBlock Text="{Binding Unit}" Classes="dim" VerticalAlignment="Center"
                                   IsVisible="{Binding HasUnit}"/>
                      </StackPanel>
                      <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Spacing="6"
                                  VerticalAlignment="Top" IsVisible="{Binding ShowAdd}">
                        <TextBox Name="AddDraft" Classes="field" MinWidth="120" MinHeight="30"
                                 Watermark="new value…" Text="{Binding Draft, Mode=TwoWay}"/>
                        <Button Name="AddButton" Classes="primary" Content="Add"
                                Command="{Binding $parent[UserControl].((vm:WorkspaceViewModel)DataContext).AddCommand}"
                                CommandParameter="{Binding}"/>
                      </StackPanel>
                      <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Spacing="8"
                                  VerticalAlignment="Top" IsVisible="{Binding ShowRemove}">
                        <Border Classes="chip" VerticalAlignment="Center">
                          <TextBlock Text="added" Classes="dim" Foreground="{StaticResource AccentBrush}"/>
                        </Border>
                        <Button Name="RemoveButton" Classes="secondary" Content="Remove"
                                Command="{Binding $parent[UserControl].((vm:WorkspaceViewModel)DataContext).RemoveCommand}"
                                CommandParameter="{Binding}"/>
                      </StackPanel>
                      <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Classes="dim"
                                 TextWrapping="Wrap" Margin="0,6,0,0" Text="{Binding Meaning}"
                                 IsVisible="{Binding HasMeaning}"/>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>
          </StackPanel>
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </Grid>
</UserControl>
