<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:SCMW.App"
             xmlns:content="clr-namespace:SCMW.Core.Content;assembly=SCMW.Core"
             xmlns:controls="clr-namespace:SCMW.App.Controls"
             x:Class="SCMW.App.Views.WorkspaceView"
             x:DataType="vm:WorkspaceViewModel">
  <!-- The adapting Workspace: find a file by name and the game's own category, tick "only
       changeable" to hide the rest, then its real fields show, explained, on the right. -->
  <Grid ColumnDefinitions="2*,12,3*" RowDefinitions="Auto,*" Margin="28,8,28,24">

    <!-- "One project = one mod": with nothing chosen, editing is refused and explained here. -->
    <Border Grid.Row="0" Grid.ColumnSpan="3" Name="NeedsProjectWarning" Classes="card"
            IsVisible="{Binding NeedsProject}" Margin="0,0,0,12">
      <TextBlock Text="{Binding ProjectWarning}" TextWrapping="Wrap"
                 Foreground="{StaticResource WarningBrush}"/>
    </Border>

    <!-- Left: find + browse -->
    <Grid Grid.Row="1" Grid.Column="0" RowDefinitions="Auto,Auto,Auto,*">
      <ListBox Grid.Row="0" Name="KindChips" Classes="chips"
               ItemsSource="{Binding Kinds}"
               SelectedItem="{Binding SelectedKind, Mode=TwoWay}">
        <ListBox.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel/>
          </ItemsPanelTemplate>
        </ListBox.ItemsPanel>
        <ListBox.ItemTemplate>
          <DataTemplate>
            <TextBlock Text="{Binding}"/>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <TextBox Grid.Row="1" Name="SearchBox" Classes="field" Margin="0,12,0,0" Watermark="Search by name…"
               Text="{Binding Search, Mode=TwoWay}"/>

      <ListBox Grid.Row="2" Name="CategoryChips" Classes="chips" Margin="0,12,0,0"
               ItemsSource="{Binding Categories}"
               SelectedItem="{Binding SelectedCategory, Mode=TwoWay}">
        <ListBox.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel/>
          </ItemsPanelTemplate>
        </ListBox.ItemsPanel>
        <ListBox.ItemTemplate>
          <DataTemplate>
            <TextBlock Text="{Binding}"/>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <ListBox Grid.Row="3" Name="AssetList" Classes="items" Margin="0,8,0,0" Padding="0,0,12,0"
               ItemsSource="{Binding VisibleAssets}"
               SelectedItem="{Binding SelectedAsset, Mode=TwoWay}"
               IsVisible="{Binding HasAssetMatches}">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:ItemSummary">
            <controls:ItemRow Item="{Binding}"/>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <Border Grid.Row="3" Name="NoAssetMatches" Classes="card" VerticalAlignment="Top"
              IsVisible="{Binding ShowAssetNoMatches}">
        <TextBlock Text="Nothing matches that" Classes="dim"/>
      </Border>
    </Grid>

    <!-- Right: the open file's real fields, explained -->
    <Grid Grid.Row="1" Grid.Column="2" RowDefinitions="Auto,Auto,*">
      <TextBlock Grid.Row="0" Name="TitleText" Classes="h1" Text="{Binding Title}"
                 IsVisible="{Binding HasFields}"/>

      <TextBlock Grid.Row="1" Classes="dim" Margin="0,8,0,0"
                 Text="This file has no values to show."
                 IsVisible="{Binding !HasFields}"/>

      <ScrollViewer Grid.Row="2" Margin="0,12,0,0" Padding="0,0,12,0">
        <StackPanel>
          <!-- A recipe's ingredients: one row per slot, editable (its accepted tag + the five
               per-skill amounts). Those values are owned here, so they leave the list below. -->
          <Border Name="IngredientsCard" Classes="card" Margin="0,0,0,14"
                  IsVisible="{Binding HasIngredients}">
            <StackPanel>
              <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,10">
                <TextBlock Grid.Column="0" Classes="section" Text="Ingredients" VerticalAlignment="Center"/>
                <Button Grid.Column="1" Name="AddIngredient" Classes="secondary" Content="＋ Add ingredient"
                        ToolTip.Tip="Add another ingredient slot"
                        Command="{Binding AddIngredientSlotCommand}"/>
              </Grid>
              <TextBlock Text="{Binding IngredientNotice}" TextWrapping="Wrap" Classes="dim"
                         Foreground="{StaticResource WarningBrush}" Margin="0,0,0,10"
                         IsVisible="{Binding HasIngredientNotice}"/>
              <ItemsControl Name="IngredientList" ItemsSource="{Binding IngredientSlots}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:IngredientSlotRow">
                    <Border Classes="card" Margin="0,0,0,10" Padding="12">
                      <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                        <StackPanel Grid.Row="0" Grid.Column="0" Spacing="6" Margin="0,0,12,0">
                          <TextBlock Text="{Binding Header}" Foreground="{StaticResource TextDimBrush}"/>
                          <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="Accepts" Classes="dim" VerticalAlignment="Center"/>
                            <ComboBox Name="TagPicker" MinWidth="200"
                                      ItemsSource="{Binding TagChoices}"
                                      SelectedItem="{Binding SelectedTag, Mode=TwoWay}"
                                      SelectionChanged="OnTagChanged">
                              <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="content:RecipeTag">
                                  <TextBlock Text="{Binding Label}"/>
                                </DataTemplate>
                              </ComboBox.ItemTemplate>
                            </ComboBox>
                          </StackPanel>
                        </StackPanel>

                        <Button Grid.Row="0" Grid.Column="1" Name="RemoveIngredient" Classes="secondary"
                                Content="✕" VerticalAlignment="Top" ToolTip.Tip="Remove this ingredient"
                                Command="{Binding $parent[UserControl].((vm:WorkspaceViewModel)DataContext).RemoveIngredientSlotCommand}"
                                CommandParameter="{Binding}"/>

                        <!-- The five per-skill amounts: click a value to type a new one. -->
                        <ItemsControl Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,10,0,0"
                                      ItemsSource="{Binding Amounts}">
                          <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                              <WrapPanel/>
                            </ItemsPanelTemplate>
                          </ItemsControl.ItemsPanel>
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:WorkspaceField">
                              <StackPanel Margin="0,0,14,8" Spacing="2">
                                <TextBlock Text="{Binding Label}" Classes="dim"/>
                                <Button Classes="valuefield" MinWidth="72" HorizontalContentAlignment="Left"
                                        IsVisible="{Binding ShowValueButton}"
                                        Command="{Binding $parent[UserControl].((vm:WorkspaceViewModel)DataContext).BeginEditCommand}"
                                        CommandParameter="{Binding}">
                                  <TextBlock Text="{Binding Value}" Classes.changed="{Binding IsChanged}"/>
                                </Button>
                                <TextBox Classes="field" MinWidth="72" MinHeight="28"
                                         IsVisible="{Binding IsEditing}" Text="{Binding Draft, Mode=TwoWay}"
                                         KeyDown="OnAmountKeyDown" LostFocus="OnAmountLostFocus"/>
                              </StackPanel>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>

          <!-- A dish's ingredients: one row per ingredient, each with its title and the foods it may
               take (a food points at an item and carries five values). Those values are owned here,
               so they leave the list below. -->
          <Border Name="CookingCard" Classes="card" Margin="0,0,0,14"
                  IsVisible="{Binding HasCookingIngredients}">
            <StackPanel>
              <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,0,0,10">
                <TextBlock Grid.Column="0" Classes="section" Text="Ingredients" VerticalAlignment="Center"/>
                <Button Grid.Column="1" Name="AddCookingMainIngredient" Classes="secondary" Content="＋ Main"
                        ToolTip.Tip="Add a main ingredient" Margin="0,0,6,0"
                        Command="{Binding AddCookingMainIngredientCommand}"/>
                <Button Grid.Column="2" Name="AddCookingOptionalIngredient" Classes="secondary" Content="＋ Optional"
                        ToolTip.Tip="Add an optional ingredient"
                        Command="{Binding AddCookingOptionalIngredientCommand}"/>
              </Grid>
              <TextBlock Text="{Binding CookingNotice}" TextWrapping="Wrap" Classes="dim"
                         Foreground="{StaticResource WarningBrush}" Margin="0,0,0,10"
                         IsVisible="{Binding HasCookingNotice}"/>
              <ItemsControl Name="CookingIngredientList" ItemsSource="{Binding CookingSlots}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:CookingIngredientRow">
                    <Border Classes="card" Margin="0,0,0,10" Padding="12">
                      <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                        <StackPanel Grid.Row="0" Grid.Column="0" Spacing="6" Margin="0,0,12,0">
                          <TextBlock Text="{Binding Header}" Foreground="{StaticResource TextDimBrush}"/>
                          <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding HasTitle}">
                            <TextBlock Text="Title" Classes="dim" VerticalAlignment="Center"/>
                            <Button Classes="valuefield" MinWidth="120" HorizontalContentAlignment="Left"
                                    IsVisible="{Binding Title.ShowValueButton}"
                                    Command="{Binding $parent[UserControl].((vm:WorkspaceViewModel)DataContext).BeginEditCommand}"
                                    CommandParameter="{Binding Title}">
                              <TextBlock Text="{Binding Title.Value}" Classes.changed="{Binding Title.IsChanged}"/>
                            </Button>
                            <TextBox Classes="field" MinWidth="120" MinHeight="28"
                                     IsVisible="{Binding Title.IsEditing}" Text="{Binding Title.Draft, Mode=TwoWay}"
                                     KeyDown="OnAmountKeyDown" LostFocus="OnAmountLostFocus"/>
                          </StackPanel>
                        </StackPanel>

                        <Button Grid.Row="0" Grid.Column="1" Name="RemoveCookingIngredient" Classes="secondary"
                                Content="✕" VerticalAlignment="Top" ToolTip.Tip="Remove this ingredient"
                                Command="{Binding $parent[UserControl].((vm:WorkspaceViewModel)DataContext).RemoveCookingIngredientCommand}"
                                CommandParameter="{Binding}"/>

                        <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Spacing="8" Margin="0,10,0,0">
                          <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0" Text="Foods" Classes="dim" VerticalAlignment="Center"/>
                            <Button Grid.Column="1" Name="AddCookingFood" Classes="secondary" Content="＋ Add food"
                                    ToolTip.Tip="Add a food this ingredient may take"
                                    Command="{Binding $parent[UserControl].((vm:WorkspaceViewModel)DataContext).AddCookingFoodCommand}"
                                    CommandParameter="{Binding}"/>
                          </Grid>
                          <ItemsControl Name="CookingFoodList" ItemsSource="{Binding Foods}">
                            <ItemsControl.ItemTemplate>
                              <DataTemplate x:DataType="vm:CookingFoodRow">
                                <Border Classes="card" Margin="0,0,0,8" Padding="10">
                                  <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                                    <StackPanel Grid.Row="0" Grid.Column="0" Spacing="6" Margin="0,0,12,0">
                                      <TextBlock Text="{Binding Header}" Foreground="{StaticResource TextDimBrush}"/>
                                      <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock Text="Item" Classes="dim" VerticalAlignment="Center"/>
                                        <ComboBox Name="FoodPicker" MinWidth="200"
                                                  ItemsSource="{Binding Choices}"
                                                  SelectedItem="{Binding SelectedFood, Mode=TwoWay}"
                                                  SelectionChanged="OnCookingFoodChanged">
                                          <ComboBox.ItemTemplate>
                                            <DataTemplate x:DataType="content:CookingFood">
                                              <TextBlock Text="{Binding Label}"/>
                                            </DataTemplate>
                                          </ComboBox.ItemTemplate>
                                        </ComboBox>
                                      </StackPanel>
                                    </StackPanel>
                                    <Button Grid.Row="0" Grid.Column="1" Name="RemoveCookingFood" Classes="secondary"
                                            Content="✕" VerticalAlignment="Top" ToolTip.Tip="Remove this food"
                                            Command="{Binding $parent[UserControl].((vm:WorkspaceViewModel)DataContext).RemoveCookingFoodCommand}"
                                            CommandParameter="{Binding}"/>
                                    <ItemsControl Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,10,0,0"
                                                  ItemsSource="{Binding Values}">
                                      <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                          <WrapPanel/>
                                        </ItemsPanelTemplate>
                                      </ItemsControl.ItemsPanel>
                                      <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:WorkspaceField">
                                          <StackPanel Margin="0,0,14,8" Spacing="2">
                                            <TextBlock Text="{Binding Label}" Classes="dim"/>
                                            <Button Classes="valuefield" MinWidth="72" HorizontalContentAlignment="Left"
                                                    IsVisible="{Binding ShowValueButton}"
                                                    Command="{Binding $parent[UserControl].((vm:WorkspaceViewModel)DataContext).BeginEditCommand}"
                                                    CommandParameter="{Binding}">
                                              <TextBlock Text="{Binding Value}" Classes.changed="{Binding IsChanged}"/>
                                            </Button>
                                            <TextBox Classes="field" MinWidth="72" MinHeight="28"
                                                     IsVisible="{Binding IsEditing}" Text="{Binding Draft, Mode=TwoWay}"
                                                     KeyDown="OnAmountKeyDown" LostFocus="OnAmountLostFocus"/>
                                          </StackPanel>
                                        </DataTemplate>
                                      </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                  </Grid>
                                </Border>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                        </StackPanel>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>

          <ItemsControl Name="FieldList" ItemsSource="{Binding Fields}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:WorkspaceField">
                <controls:FieldRow Margin="0,0,0,14"
                    BeginEditCommand="{Binding $parent[UserControl].((vm:WorkspaceViewModel)DataContext).BeginEditCommand}"
                    CommitEditCommand="{Binding $parent[UserControl].((vm:WorkspaceViewModel)DataContext).CommitEditCommand}"
                    CancelEditCommand="{Binding $parent[UserControl].((vm:WorkspaceViewModel)DataContext).CancelEditCommand}"
                    BeginMultiplyCommand="{Binding $parent[UserControl].((vm:WorkspaceViewModel)DataContext).BeginMultiplyCommand}"
                    CommitMultiplyCommand="{Binding $parent[UserControl].((vm:WorkspaceViewModel)DataContext).CommitMultiplyCommand}"
                    CancelMultiplyCommand="{Binding $parent[UserControl].((vm:WorkspaceViewModel)DataContext).CancelMultiplyCommand}"/>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <!-- Fields this file lacks that we can add by copying a donor item's shape (Task 5.2). -->
          <Border Name="AddableSection" Classes="card" Margin="0,12,0,0"
                  IsVisible="{Binding HasAddableFields}">
            <StackPanel>
              <TextBlock Classes="section" Text="Add a value this item doesn't have" Margin="0,0,0,10"/>
              <ItemsControl Name="AddableList" ItemsSource="{Binding AddableFields}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:AddableField">
                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" Margin="0,0,0,14">
                      <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Spacing="6"
                                  VerticalAlignment="Top" Margin="0,7,0,0">
                        <TextBlock Text="{Binding Label}" Foreground="{StaticResource TextDimBrush}"/>
                        <TextBlock Text="{Binding Unit}" Classes="dim" VerticalAlignment="Center"
                                   IsVisible="{Binding HasUnit}"/>
                      </StackPanel>
                      <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Spacing="6"
                                  VerticalAlignment="Top" IsVisible="{Binding ShowAdd}">
                        <TextBox Name="AddDraft" Classes="field" MinWidth="120" MinHeight="30"
                                 Watermark="new value…" Text="{Binding Draft, Mode=TwoWay}"/>
                        <Button Name="AddButton" Classes="primary" Content="Add"
                                Command="{Binding $parent[UserControl].((vm:WorkspaceViewModel)DataContext).AddCommand}"
                                CommandParameter="{Binding}"/>
                      </StackPanel>
                      <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Spacing="8"
                                  VerticalAlignment="Top" IsVisible="{Binding ShowRemove}">
                        <Border Classes="chip" VerticalAlignment="Center">
                          <TextBlock Text="added" Classes="dim" Foreground="{StaticResource AccentBrush}"/>
                        </Border>
                        <Button Name="RemoveButton" Classes="secondary" Content="Remove"
                                Command="{Binding $parent[UserControl].((vm:WorkspaceViewModel)DataContext).RemoveCommand}"
                                CommandParameter="{Binding}"/>
                      </StackPanel>
                      <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Classes="dim"
                                 TextWrapping="Wrap" Margin="0,6,0,0" Text="{Binding Meaning}"
                                 IsVisible="{Binding HasMeaning}"/>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </Grid>
</UserControl>
