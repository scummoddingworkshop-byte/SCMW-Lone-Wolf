<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:SCMW.App"
             xmlns:controls="clr-namespace:SCMW.App.Controls"
             xmlns:views="clr-namespace:SCMW.App.Views"
             x:Class="SCMW.App.Views.HomeView"
             x:DataType="vm:HomeViewModel">
  <ScrollViewer>
    <StackPanel Spacing="20" Margin="24,8,24,24">

      <!-- Hero band: the artwork (its title is baked in) sits in the border's background, so it clips
           to the rounded corners. Its height follows its width, so the title always fits — kept to a
           slim band, so the page's own content stays above the fold. -->
      <Border Name="Hero" Classes="hero"
              Height="{Binding $self.Bounds.Width, Converter={StaticResource ScaleConverter}, ConverterParameter=0.24}">
        <Border.Background>
          <ImageBrush Source="avares://SCMW-Lone-Wolf/Assets/hero.png" Stretch="UniformToFill"/>
        </Border.Background>
      </Border>

      <!-- First-run card: points a new player at Settings (game folder + unlock key). -->
      <Border Name="WelcomeCard" Classes="card" IsVisible="{Binding ShowWelcome}">
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel Grid.Column="0" Spacing="4">
            <TextBlock Text="Set up SCUM first" FontSize="16" FontWeight="SemiBold"
                       Foreground="{StaticResource TextPrimaryBrush}"/>
            <TextBlock Text="Tell SCMW — Lone Wolf where SCUM is, and add your unlock key — then you're ready to start modding."
                       Classes="dim" TextWrapping="Wrap"/>
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <Button Classes="primary" Content="Open Settings" Command="{Binding StartWelcomeCommand}"/>
            <Button Content="✕" ToolTip.Tip="Dismiss" Command="{Binding DismissWelcomeCommand}"/>
          </StackPanel>
        </Grid>
      </Border>

      <!-- The chooser, folded into Home: the friendly "what would you like to change?" front door. -->
      <views:ChooserView DataContext="{Binding Chooser}"/>

      <!-- Quick actions: four different places to go. Changing something is the chooser's job, above. -->
      <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="12">
        <Button Grid.Column="0" Classes="quickaction" HorizontalAlignment="Stretch"
                Command="{Binding OpenProjectsCommand}">
          <StackPanel Spacing="6">
            <Border Width="44" Height="44" CornerRadius="8" HorizontalAlignment="Left"
                    Background="{StaticResource AccentSoftBrush}">
              <Image Source="avares://SCMW-Lone-Wolf/Assets/rail/projects.png" Width="26" Height="26"
                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <TextBlock Text="Your projects" FontWeight="SemiBold"
                       Foreground="{StaticResource TextPrimaryBrush}"/>
            <TextBlock Text="Start a new mod, or carry on with one" Classes="dim" TextWrapping="Wrap"/>
          </StackPanel>
        </Button>
        <Button Grid.Column="1" Classes="quickaction" HorizontalAlignment="Stretch"
                Command="{Binding BuildModCommand}">
          <StackPanel Spacing="6">
            <Border Width="44" Height="44" CornerRadius="8" HorizontalAlignment="Left"
                    Background="{StaticResource AccentSoftBrush}">
              <Image Source="avares://SCMW-Lone-Wolf/Assets/rail/build.png" Width="26" Height="26"
                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <TextBlock Text="Build your mod" FontWeight="SemiBold"
                       Foreground="{StaticResource TextPrimaryBrush}"/>
            <TextBlock Text="Package your changes into a .pak" Classes="dim" TextWrapping="Wrap"/>
          </StackPanel>
        </Button>
        <Button Grid.Column="2" Classes="quickaction" HorizontalAlignment="Stretch"
                Command="{Binding ManageModsCommand}">
          <StackPanel Spacing="6">
            <Border Width="44" Height="44" CornerRadius="8" HorizontalAlignment="Left"
                    Background="{StaticResource AccentSoftBrush}">
              <Image Source="avares://SCMW-Lone-Wolf/Assets/rail/mods.png" Width="26" Height="26"
                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <TextBlock Text="Manage your mods" FontWeight="SemiBold"
                       Foreground="{StaticResource TextPrimaryBrush}"/>
            <TextBlock Text="Switch mods on and off, or pack them to share" Classes="dim"
                       TextWrapping="Wrap"/>
          </StackPanel>
        </Button>
        <Button Grid.Column="3" Classes="quickaction" HorizontalAlignment="Stretch"
                Command="{Binding OpenBackupsCommand}">
          <StackPanel Spacing="6">
            <Border Width="44" Height="44" CornerRadius="8" HorizontalAlignment="Left"
                    Background="{StaticResource AccentSoftBrush}">
              <Image Source="avares://SCMW-Lone-Wolf/Assets/rail/backups.png" Width="26" Height="26"
                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <TextBlock Text="Backups" FontWeight="SemiBold"
                       Foreground="{StaticResource TextPrimaryBrush}"/>
            <TextBlock Text="Your saved game, projects and mods, kept safe" Classes="dim"
                       TextWrapping="Wrap"/>
          </StackPanel>
        </Button>
      </Grid>

      <!-- Recent projects. -->
      <StackPanel Spacing="10">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Grid.Column="0" Text="Recent projects" Classes="section" VerticalAlignment="Center"/>
          <Button Grid.Column="1" Classes="secondary" Content="View all"
                  Command="{Binding ViewAllProjectsCommand}"/>
        </Grid>

        <ItemsControl Name="ProjectList" ItemsSource="{Binding RecentProjects}"
                      IsVisible="{Binding HasProjects}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <UniformGrid Columns="4" ColumnSpacing="12"/>
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:ProjectSummary">
              <!-- The same card the Projects screen uses, so a project looks the same in both places. -->
              <controls:ProjectTile Project="{Binding}"
                                    OpenCommand="{Binding $parent[UserControl].((vm:HomeViewModel)DataContext).OpenRecentProjectCommand}"/>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Border Name="EmptyState" Classes="card" IsVisible="{Binding !HasProjects}">
          <StackPanel Spacing="10">
            <TextBlock Text="No projects yet — start one" FontSize="16" FontWeight="SemiBold"
                       Foreground="{StaticResource TextPrimaryBrush}"/>
            <TextBlock Text="Create a project and your changes will have somewhere to live." Classes="dim"/>
            <Button Classes="primary" Content="Go to Projects" HorizontalAlignment="Left"
                    Command="{Binding OpenProjectsCommand}"/>
          </StackPanel>
        </Border>
      </StackPanel>

    </StackPanel>
  </ScrollViewer>
</UserControl>
