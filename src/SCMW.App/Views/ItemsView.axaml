<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:SCMW.App"
             xmlns:controls="clr-namespace:SCMW.App.Controls"
             x:Class="SCMW.App.Views.ItemsView"
             x:DataType="vm:ItemsViewModel">
  <Grid ColumnDefinitions="2*,12,3*" Margin="24,8,24,24">

    <!-- Left: find -->
    <Grid Grid.Column="0" RowDefinitions="Auto,Auto,Auto,*">
      <TextBox Grid.Row="0" Name="SearchBox" Classes="field" Watermark="{Binding SearchWatermark}"
               Text="{Binding Search, Mode=TwoWay}"/>

      <Grid Grid.Row="1" Margin="0,12,0,0" RowDefinitions="Auto,Auto">
        <ListBox Grid.Row="0" Name="CategoryChips" Classes="chips"
                 ItemsSource="{Binding ShownCategories}"
                 SelectedItem="{Binding SelectedCategory, Mode=TwoWay}">
          <ListBox.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel/>
            </ItemsPanelTemplate>
          </ListBox.ItemsPanel>
          <ListBox.ItemTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding}"/>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

        <Button Grid.Row="1" Name="MoreCategoriesButton" Classes="secondary"
                HorizontalAlignment="Left" Margin="0,0,0,0" Padding="10,4" FontSize="12"
                Content="{Binding CategoriesToggleLabel}"
                IsVisible="{Binding HasMoreCategories}"
                Command="{Binding ToggleCategoriesCommand}"/>
      </Grid>

      <CheckBox Grid.Row="2" Name="OnlyEditableBox" Margin="0,12,0,0"
                Content="Show only items this mod can change"
                IsVisible="{Binding ShowOnlyEditableToggle}"
                IsChecked="{Binding OnlyEditable, Mode=TwoWay}"/>

      <ListBox Grid.Row="3" Name="ItemList" Classes="items" Margin="0,8,0,0"
               ItemsSource="{Binding VisibleItems}"
               SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
               IsVisible="{Binding HasMatches}">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:ItemSummary">
            <controls:ItemRow Item="{Binding}"/>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <Border Grid.Row="3" Name="NoMatches" Classes="card" VerticalAlignment="Top"
              IsVisible="{Binding ShowNoMatches}">
        <TextBlock Text="{Binding NoMatchesText}" Classes="dim"/>
      </Border>

      <Border Grid.Row="3" Name="EmptyState" Classes="card" VerticalAlignment="Top"
              IsVisible="{Binding ShowEmptyState}">
        <StackPanel Spacing="6">
          <TextBlock Text="{Binding EmptyTitle}" FontSize="16" FontWeight="SemiBold"
                     Foreground="{StaticResource TextPrimaryBrush}"/>
          <TextBlock Text="{Binding EmptyText}" Classes="dim"/>
        </StackPanel>
      </Border>
    </Grid>

    <!-- Right: work -->
    <ScrollViewer Grid.Column="2">
      <DockPanel LastChildFill="False">
        <TextBlock DockPanel.Dock="Top" Margin="0,0,0,8" Classes="dim" TextWrapping="Wrap"
                   Text="{Binding SourceNote}"
                   IsVisible="{Binding SourceNote, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

        <Panel DockPanel.Dock="Top">
        <Border Name="Hint" Classes="card" IsVisible="{Binding ShowHint}">
          <StackPanel Spacing="6">
            <TextBlock Text="{Binding HintTitle}" FontSize="16" FontWeight="SemiBold"
                       Foreground="{StaticResource TextPrimaryBrush}"/>
            <TextBlock Text="{Binding HintText}" Classes="dim"/>
          </StackPanel>
        </Border>

        <Border Name="Detail" Classes="card" IsVisible="{Binding HasSelection}">
          <StackPanel Spacing="16">
            <StackPanel Spacing="10">
              <TextBlock Text="{Binding SelectedItem.Name}" Classes="h1"/>
              <TextBlock Text="{Binding SelectedItem.Description}" Classes="dim"/>
            </StackPanel>

            <CheckBox Content="Show all values" IsChecked="{Binding ShowAllValues, Mode=TwoWay}"/>

            <Button Name="AddIngredientButton" Classes="secondary" Content="Add ingredient"
                    HorizontalAlignment="Left" IsVisible="{Binding CanManageIngredients}"
                    Command="{Binding AddIngredientCommand}"/>

            <TextBlock Text="{Binding RefusalMessage}" IsVisible="{Binding ShowRefusal}"
                       Foreground="{StaticResource WarningBrush}" TextWrapping="Wrap"/>

            <ItemsControl ItemsSource="{Binding Sections}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ValueGroup">
                  <StackPanel Spacing="8" Margin="0,0,0,16">
                    <Border Background="{StaticResource AccentSoftBrush}" CornerRadius="4" Padding="8,4">
                      <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Text="{Binding Name}" Classes="section" VerticalAlignment="Center"/>
                        <Button Name="RemoveIngredientButton" Classes="secondary" Padding="8,2" FontSize="12"
                                Content="Remove ingredient"
                                IsVisible="{Binding RemovePath, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                Command="{Binding $parent[UserControl].((vm:ItemsViewModel)DataContext).RemoveIngredientCommand}"
                                CommandParameter="{Binding RemovePath}"/>
                      </StackPanel>
                    </Border>
                    <ItemsControl ItemsSource="{Binding Values}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ItemValue">
                          <controls:ItemValueRow
                              BeginEditCommand="{Binding $parent[UserControl].((vm:ItemsViewModel)DataContext).BeginEditCommand}"
                              CommitEditCommand="{Binding $parent[UserControl].((vm:ItemsViewModel)DataContext).CommitEditCommand}"
                              CancelEditCommand="{Binding $parent[UserControl].((vm:ItemsViewModel)DataContext).CancelEditCommand}"/>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Name="NoValuesText" Text="{Binding NoValuesText}" Classes="dim"
                       TextWrapping="Wrap" IsVisible="{Binding ShowNoValues}"/>
          </StackPanel>
        </Border>
        </Panel>
      </DockPanel>
    </ScrollViewer>
  </Grid>
</UserControl>

