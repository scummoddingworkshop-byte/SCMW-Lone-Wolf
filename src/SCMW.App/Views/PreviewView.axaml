<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:SCMW.App"
             x:Class="SCMW.App.Views.PreviewView"
             x:DataType="vm:PreviewViewModel">
  <ScrollViewer>
    <StackPanel Spacing="16" Margin="24,8,24,24">

      <TextBlock Text="Preview" Classes="h1"/>

      <!-- The chosen project's picture, full width, cropped into a banner (max 200 tall). -->
      <Border Name="ProjectBanner" Height="200" CornerRadius="10" ClipToBounds="True"
              IsVisible="{Binding HasProjectPicture}">
        <Image Name="ProjectPicture" Source="{Binding ProjectPicture}" Stretch="UniformToFill"/>
      </Border>

      <!-- Which mod this preview is about, in a prominent line. -->
      <TextBlock Name="ProjectNameText" Text="{Binding ProjectName}" FontSize="20" FontWeight="SemiBold"
                 Foreground="{StaticResource TextPrimaryBrush}"/>

      <!-- No project chosen yet: say so instead of showing a fall-back's changes. -->
      <Border Name="NeedsProjectWarning" Classes="card" IsVisible="{Binding NeedsProject}">
        <TextBlock Text="{Binding ProjectWarning}" TextWrapping="Wrap"
                   Foreground="{StaticResource WarningBrush}"/>
      </Border>

      <!-- Nothing to show yet. -->
      <Border Name="NoChanges" Classes="card" IsVisible="{Binding !HasChanges}">
        <TextBlock Text="{Binding NoChangesNote}" Classes="dim" TextWrapping="Wrap"/>
      </Border>

      <!-- Exactly what will change: one card per item, each value before → after. -->
      <ItemsControl Name="ChangeList" ItemsSource="{Binding Changes}" IsVisible="{Binding HasChanges}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:BuildChange">
            <Border Classes="card" Margin="0,0,0,10">
              <StackPanel Spacing="8">

                <!-- The item: its picture, its friendly name, and its full game path in brackets. -->
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <Border Classes="thumb" Width="32" Height="32" VerticalAlignment="Center">
                    <Panel>
                      <TextBlock Text="SCMW" FontSize="8"
                                 Foreground="{StaticResource TextDimBrush}"
                                 HorizontalAlignment="Center" VerticalAlignment="Center"/>
                      <Image Source="{Binding Picture}" Stretch="UniformToFill"
                             IsVisible="{Binding HasPicture}"/>
                    </Panel>
                  </Border>
                  <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding FriendlyName}" FontSize="15" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock Text="{Binding Path, StringFormat='({0})'}" Classes="dim"
                               TextWrapping="Wrap"/>
                  </StackPanel>
                </StackPanel>

                <ItemsControl ItemsSource="{Binding Values}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:BuildValueChange">
                      <Grid ColumnDefinitions="Auto,12,*" Margin="0,2,0,0">
                        <TextBlock Grid.Column="0" Text="{Binding ValueName}" Classes="dim"/>
                        <TextBlock Grid.Column="2" Text="{Binding Summary}"/>
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>

              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

    </StackPanel>
  </ScrollViewer>
</UserControl>
