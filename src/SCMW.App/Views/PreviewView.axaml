<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:SCMW.App"
             x:Class="SCMW.App.Views.PreviewView"
             x:DataType="vm:PreviewViewModel">
  <!-- "What's in this mod" — the preview/diff, embedded in Build. The body scrolls on its own so a
       long mod can never push the Build button off screen. -->
  <StackPanel Spacing="14">

    <TextBlock Text="What's in this mod" Classes="h1"/>

    <ScrollViewer Name="PreviewScroll" MaxHeight="520" VerticalScrollBarVisibility="Auto">
      <StackPanel Spacing="14" Margin="0,0,12,0">

        <!-- The chosen project's picture, full width, cropped into a banner (max 200 tall). -->
        <Border Name="ProjectBanner" Height="200" CornerRadius="10" ClipToBounds="True"
                IsVisible="{Binding HasProjectPicture}">
          <Image Name="ProjectPicture" Source="{Binding ProjectPicture}" Stretch="UniformToFill"/>
        </Border>

        <!-- Which mod this preview is about, in a prominent line. -->
        <TextBlock Name="ProjectNameText" Text="{Binding ProjectName}" FontSize="20" FontWeight="SemiBold"
                   Foreground="{StaticResource TextPrimaryBrush}"/>

        <!-- No project chosen yet: say so instead of showing a fall-back's changes. -->
        <Border Name="NeedsProjectWarning" Classes="card" IsVisible="{Binding NeedsProject}">
          <TextBlock Text="{Binding ProjectWarning}" TextWrapping="Wrap"
                     Foreground="{StaticResource WarningBrush}"/>
        </Border>

        <!-- Nothing to show yet. -->
        <Border Name="NoChanges" Classes="card" IsVisible="{Binding !HasChanges}">
          <TextBlock Text="{Binding NoChangesNote}" Classes="dim" TextWrapping="Wrap"/>
        </Border>

        <!-- Exactly what will change: one card per item, each value before → after. -->
        <ItemsControl Name="ChangeList" ItemsSource="{Binding Changes}" IsVisible="{Binding HasChanges}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:BuildChange">
              <Border Classes="card" Padding="14,12" Margin="0,0,0,8">
                <Grid ColumnDefinitions="2*,1*,Auto" ColumnSpacing="16" Grid.IsSharedSizeScope="True">

                  <!-- Left (about two thirds): the item's picture and its name, centred on each other. -->
                  <Grid Grid.Column="0" ColumnDefinitions="Auto,*" ColumnSpacing="10"
                        VerticalAlignment="Center">
                    <Border Grid.Column="0" Classes="thumb" Width="34" Height="34">
                      <Panel>
                        <TextBlock Text="SCMW" FontSize="8"
                                   Foreground="{StaticResource TextDimBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <Image Source="{Binding Picture}" Stretch="UniformToFill"
                               IsVisible="{Binding HasPicture}"/>
                      </Panel>
                    </Border>
                    <Grid Grid.Column="1" ColumnDefinitions="Auto,*" ColumnSpacing="8"
                          VerticalAlignment="Center">
                      <TextBlock Grid.Column="0" Text="{Binding FriendlyName}" FontSize="15"
                                 FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"
                                 VerticalAlignment="Center"/>
                      <TextBlock Grid.Column="1" Text="{Binding Path, StringFormat='({0})'}" FontSize="11"
                                 Foreground="{StaticResource TextDimBrush}" VerticalAlignment="Center"
                                 TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Path}"/>
                    </Grid>
                  </Grid>

                  <!-- Right (about one third): the changed fields, centred on the item block. The tags
                       share one column and the values share another, so both line up down the card. -->
                  <ItemsControl Grid.Column="1" ItemsSource="{Binding Values}" VerticalAlignment="Center">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:BuildValueChange">
                        <Grid ColumnSpacing="8" Margin="0,1,0,1">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="pvTag"/>
                            <ColumnDefinition Width="*"/>
                          </Grid.ColumnDefinitions>
                          <TextBlock Grid.Column="0" Text="{Binding ValueName}" FontSize="12"
                                     Foreground="{StaticResource TextDimBrush}" VerticalAlignment="Center"/>
                          <TextBlock Grid.Column="1" Text="{Binding Summary}" FontSize="12"
                                     Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>

                  <!-- Take this item out of the mod (undo all of its changes). -->
                  <Button Grid.Column="2" Classes="secondary" Content="Remove" VerticalAlignment="Center"
                          ToolTip.Tip="Remove this item's changes"
                          Command="{Binding $parent[UserControl].((vm:PreviewViewModel)DataContext).RemoveItemCommand}"
                          CommandParameter="{Binding}"/>

                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

      </StackPanel>
    </ScrollViewer>

  </StackPanel>
</UserControl>
