<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:SCMW.App"
             xmlns:controls="clr-namespace:SCMW.App.Controls"
             x:Class="SCMW.App.Views.ProjectsView"
             x:DataType="vm:ProjectsViewModel">
  <ScrollViewer>
    <StackPanel Spacing="20" Margin="24,8,24,24">

      <!-- Header: title, search, new project. -->
      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
        <TextBlock Grid.Column="0" Text="Projects" Classes="h1" VerticalAlignment="Center"/>
        <TextBox Grid.Column="1" Name="SearchBox" Classes="field" MaxWidth="320"
                 HorizontalAlignment="Right" Watermark="Search projects…"
                 Text="{Binding Search, Mode=TwoWay}"/>
        <Button Grid.Column="2" Classes="primary" Content="New project"
                Command="{Binding NewProjectCommand}"/>
      </Grid>

      <!-- First-run card (moved here when Home retired): points a new player at Settings, because
           nothing can be modded until the game folder and unlock key are set. -->
      <Border Name="WelcomeCard" Classes="card" IsVisible="{Binding ShowWelcome}">
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel Grid.Column="0" Spacing="4">
            <TextBlock Text="Set up SCUM first" FontSize="16" FontWeight="SemiBold"
                       Foreground="{StaticResource TextPrimaryBrush}"/>
            <TextBlock Text="Tell SCMW — Lone Wolf where SCUM is, and add your unlock key — then you're ready to start modding."
                       Classes="dim" TextWrapping="Wrap"/>
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <Button Classes="primary" Content="Open Settings" Command="{Binding StartWelcomeCommand}"/>
            <Button Content="✕" ToolTip.Tip="Dismiss" Command="{Binding DismissWelcomeCommand}"/>
          </StackPanel>
        </Grid>
      </Border>

      <TextBlock Name="ListMessageText" Text="{Binding ListMessage}" TextWrapping="Wrap"
                 Foreground="{StaticResource WarningBrush}"
                 IsVisible="{Binding ShowListMessage}"/>

      <!-- Create / rename panel. -->
      <Border Name="Panel" Classes="card" IsVisible="{Binding IsPanelOpen}">
        <StackPanel Spacing="12">
          <TextBlock Name="PanelTitleText" Text="{Binding PanelTitle}" FontSize="16" FontWeight="SemiBold"
                     Foreground="{StaticResource TextPrimaryBrush}"/>
          <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="10">
            <TextBlock Grid.Row="0" Grid.Column="0" Text="Name" Classes="dim" VerticalAlignment="Center"/>
            <TextBox Grid.Row="0" Grid.Column="1" Classes="field" Text="{Binding DraftName, Mode=TwoWay}"/>
            <TextBlock Grid.Row="1" Grid.Column="0" Text="Description" Classes="dim" VerticalAlignment="Center"/>
            <TextBox Grid.Row="1" Grid.Column="1" Classes="field"
                     Text="{Binding DraftDescription, Mode=TwoWay}"/>
            <TextBlock Grid.Row="2" Grid.Column="0" Text="Picture" Classes="dim" VerticalAlignment="Top"/>
            <StackPanel Grid.Row="2" Grid.Column="1" Spacing="8">
              <StackPanel Orientation="Horizontal" Spacing="12">
                <Border Name="PanelPicture" Classes="thumb" Width="64" Height="64">
                  <Panel>
                    <TextBlock Text="SCMW" FontSize="11" Foreground="{StaticResource TextDimBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <Image Source="{Binding DraftPicture}" Stretch="UniformToFill"/>
                  </Panel>
                </Border>
                <StackPanel Spacing="6" VerticalAlignment="Center">
                  <Button Name="ChoosePictureButton" Classes="secondary" Content="Choose picture…"
                          Click="OnChoosePicture"/>
                  <Button Name="RemovePictureButton" Classes="secondary" Content="Remove picture"
                          Command="{Binding RemovePictureCommand}"/>
                </StackPanel>
              </StackPanel>
              <TextBlock Text="Recommended: a square image, 512 × 512 px (PNG or JPG, under 4 MB)."
                         Classes="dim" TextWrapping="Wrap"/>
            </StackPanel>
          </Grid>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Name="PanelActionButton" Classes="primary" Content="{Binding PanelAction}"
                    Command="{Binding CommitEditCommand}"/>
            <Button Classes="secondary" Content="Cancel" Command="{Binding CancelEditCommand}"/>
          </StackPanel>
          <TextBlock Name="PanelErrorText" Text="{Binding PanelError}" TextWrapping="Wrap"
                     Foreground="{StaticResource WarningBrush}"
                     IsVisible="{Binding PanelError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
        </StackPanel>
      </Border>

      <!-- Grid of projects. -->
      <ItemsControl Name="Grid" ItemsSource="{Binding VisibleProjects}" IsVisible="{Binding ShowGrid}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <UniformGrid ColumnSpacing="12" RowSpacing="12"
                         Columns="{Binding $self.Bounds.Width, Converter={StaticResource ColumnCountConverter}}"/>
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:ProjectSummary">
            <controls:ProjectTile Project="{Binding}"
                                  OpenCommand="{Binding $parent[UserControl].((vm:ProjectsViewModel)DataContext).OpenProjectCommand}"
                                  RenameCommand="{Binding $parent[UserControl].((vm:ProjectsViewModel)DataContext).RenameProjectCommand}"
                                  DuplicateCommand="{Binding $parent[UserControl].((vm:ProjectsViewModel)DataContext).DuplicateProjectCommand}"
                                  RequestDeleteCommand="{Binding $parent[UserControl].((vm:ProjectsViewModel)DataContext).RequestDeleteCommand}"
                                  ConfirmDeleteCommand="{Binding $parent[UserControl].((vm:ProjectsViewModel)DataContext).ConfirmDeleteCommand}"
                                  CancelDeleteCommand="{Binding $parent[UserControl].((vm:ProjectsViewModel)DataContext).CancelDeleteCommand}"/>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <!-- The chosen mod's own change list ("one project = one mod"). -->
      <Border Name="ChangeList" Classes="card" IsVisible="{Binding HasChosenProject}">
        <StackPanel Spacing="8">
          <TextBlock Text="What this mod changes" FontSize="16" FontWeight="SemiBold"
                     Foreground="{StaticResource TextPrimaryBrush}"/>
          <TextBlock Name="ChangeSummaryText" Text="{Binding ChangeSummary}" Classes="dim"/>
          <!-- Laid out like Build's "What's in this mod": one card per item, its picture and friendly
               name, its changes beside them. The cards flow into as many columns as the window fits,
               so a wide screen shows them side by side instead of one very long card. -->
          <ItemsControl Name="ChangeRows" ItemsSource="{Binding Changes}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <UniformGrid ColumnSpacing="12" RowSpacing="12"
                             Columns="{Binding $self.Bounds.Width, Converter={StaticResource ColumnCountConverter}, ConverterParameter='300,1,5'}"/>
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:ProjectChangeGroup">
                <Border Classes="card" Padding="14,12">
                  <StackPanel Spacing="10">

                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                      <Border Grid.Column="0" Classes="thumb" Width="34" Height="34">
                        <Panel>
                          <TextBlock Text="SCMW" FontSize="8"
                                     Foreground="{StaticResource TextDimBrush}"
                                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
                          <Image Source="{Binding Picture}" Stretch="UniformToFill"
                                 IsVisible="{Binding HasPicture}"/>
                        </Panel>
                      </Border>
                      <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                        <TextBlock Text="{Binding FriendlyName}" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding FileName}"/>
                        <TextBlock Text="{Binding ChangeCountText}" FontSize="12"
                                   Foreground="{StaticResource TextDimBrush}"/>
                      </StackPanel>
                    </Grid>

                    <ItemsControl ItemsSource="{Binding Rows}" Grid.IsSharedSizeScope="True">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ProjectChangeRow">
                          <Grid ColumnSpacing="10" Margin="0,1,0,1">
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="Auto" SharedSizeGroup="chTag"/>
                              <ColumnDefinition Width="*"/>
                              <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding Field}" FontSize="12"
                                       Foreground="{StaticResource TextDimBrush}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="12"
                                       Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                            <Button Grid.Column="2" Classes="secondary" Content="Undo"
                                    ToolTip.Tip="Undo just this change"
                                    Command="{Binding $parent[UserControl].((vm:ProjectsViewModel)DataContext).UndoChangeCommand}"
                                    CommandParameter="{Binding}"/>
                          </Grid>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>

                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

      <!-- No matches. -->
      <Border Name="NoMatches" Classes="card" IsVisible="{Binding ShowNoMatches}">
        <TextBlock Text="No projects match that" Classes="dim"/>
      </Border>

      <!-- Empty state. -->
      <Border Name="EmptyState" Classes="card" IsVisible="{Binding ShowEmptyState}">
        <StackPanel Spacing="10">
          <TextBlock Text="No projects yet" FontSize="16" FontWeight="SemiBold"
                     Foreground="{StaticResource TextPrimaryBrush}"/>
          <TextBlock Text="Create a project and your changes will have somewhere to live." Classes="dim"/>
          <Button Classes="primary" Content="New project" HorizontalAlignment="Left"
                  Command="{Binding NewProjectCommand}"/>
        </StackPanel>
      </Border>

    </StackPanel>
  </ScrollViewer>
</UserControl>
