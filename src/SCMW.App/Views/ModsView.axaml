<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:SCMW.App"
             xmlns:controls="clr-namespace:SCMW.App.Controls"
             x:Class="SCMW.App.Views.ModsView"
             x:DataType="vm:ModsViewModel">
  <ScrollViewer>
    <StackPanel Spacing="20" Margin="24,8,24,24">

      <StackPanel Spacing="4">
        <TextBlock Text="Mods Management" Classes="h1"/>
        <TextBlock Name="SummaryText" Text="{Binding Summary}" Classes="dim"/>
      </StackPanel>

      <TextBlock Name="MessageText" Text="{Binding Message}" Classes="dim" TextWrapping="Wrap"
                 Classes.good="{Binding IsMessageGood}"
                 IsVisible="{Binding Message, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
      <Button Name="RestartAdminButton" Classes="primary" Content="Restart as administrator"
              HorizontalAlignment="Left"
              IsVisible="{Binding CanRestartAsAdmin}"
              Command="{Binding RestartAsAdminCommand}"/>

      <Border Name="DropZone" Classes="dropzone" DragDrop.AllowDrop="True" MinHeight="160">
        <Grid>
          <!-- A dashed orange outline: the target should look like one. Drawn, because Border cannot dash. -->
          <Rectangle RadiusX="10" RadiusY="10" Stroke="{StaticResource AccentBrush}"
                     StrokeThickness="2" StrokeDashArray="5,3" IsHitTestVisible="False"/>

          <StackPanel Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Text="↓" FontSize="30" Foreground="{StaticResource AccentBrush}"
                       HorizontalAlignment="Center"/>
            <TextBlock Text="Drag a .pak here to add an external mod" Classes="dim"
                       HorizontalAlignment="Center"/>
            <Button Name="AddModButton" Classes="secondary" Content="Add a mod…"
                    HorizontalAlignment="Center" Command="{Binding AddModCommand}"/>
          </StackPanel>
        </Grid>
      </Border>

      <!-- Back up or share: the mods SCMW made, in one ZIP. -->
      <Border Name="PackCard" Classes="card">
        <StackPanel Spacing="10">
          <TextBlock Text="Back up or share your mods" Classes="section"/>
          <TextBlock Name="PackNote" Text="{Binding PackNote}" Classes="dim" TextWrapping="Wrap"/>
          <Button Name="PackModsButton" Classes="secondary" Content="Pack all mods as a ZIP…"
                  HorizontalAlignment="Left"/>
        </StackPanel>
      </Border>

      <ItemsControl Name="ModList" ItemsSource="{Binding Mods}" IsVisible="{Binding HasMods}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:InstalledMod">
            <controls:ModRow Margin="0,0,0,8"
                             RequestRemoveCommand="{Binding $parent[UserControl].((vm:ModsViewModel)DataContext).RequestRemoveCommand}"
                             ConfirmRemoveCommand="{Binding $parent[UserControl].((vm:ModsViewModel)DataContext).ConfirmRemoveCommand}"
                             CancelRemoveCommand="{Binding $parent[UserControl].((vm:ModsViewModel)DataContext).CancelRemoveCommand}"/>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <Border Name="EmptyState" Classes="card" IsVisible="{Binding ShowEmptyState}">
        <StackPanel Spacing="10">
          <TextBlock Text="No mods installed yet" FontSize="16" FontWeight="SemiBold"
                     Foreground="{StaticResource TextPrimaryBrush}"/>
          <TextBlock Text="Mods arrive two ways: build one, or drag a .pak into the window."
                     Classes="dim"/>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Classes="primary" Content="Go to Build" Command="{Binding GoToBuildCommand}"/>
            <Button Classes="secondary" Content="Add a mod…" Command="{Binding AddModCommand}"/>
          </StackPanel>
        </StackPanel>
      </Border>

    </StackPanel>
  </ScrollViewer>
</UserControl>
